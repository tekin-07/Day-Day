{
  "name": "gungun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "biome check . && tsc --noEmit && vitest run && depcruise packages apps/web/src --config .dependency-cruiser.cjs && pnpm build",
    "verify": "pnpm check && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.2",
    "fake-indexeddb": "6.2.7",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "enhanced-resolve": "5.26.0"
    }
  }
}
